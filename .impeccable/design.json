      "css": ".ds-connection{display:flex;gap:8px;align-items:center;font:12px/1.6 ui-sans-serif,system-ui,sans-serif;color:#c2d2d6;white-space:nowrap;padding-top:5px}.ds-connection>span{width:7px;height:7px;border-radius:50%;background:#defa8d}@media(max-width:600px){.ds-connection{font-size:11px}}"
    }
  ],
  "narrative": {
    "northStar": "The Connection Desk",
    "overview": "A quiet editorial desk makes the first network connection feel approachable. The pale page, navy text and restrained teal diagram establish a calm reading surface; lime marks the action that yields a result.\n\nThe local Manrope headings give the page its identity, while familiar system text carries instructions. Spacious sections and a single dark reveal panel guide attention without decorative effects. Commands stay visibly distinct in a secondary terminal.",
    "keyCharacteristics": [
      "Large, tightly set two-line display type.",
      "A pale reading surface with one dark action panel.",
      "A route diagram that explains browser proxy and VPN access.",
      "Direct controls, visible keyboard focus and readable command examples."
    ],
    "rules": [
      {
        "name": "The Result Accent Rule",
        "body": "Lime identifies the flag action and its successful result; it does not become the page background or body-text color.",
        "section": "colors"
      },
      {
        "name": "The Familiar Instructions Rule",
        "body": "Reserve the distinctive heading face for headings and the wordmark; keep prose in system sans and commands in monospace.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep the full Cyber ICE Box wordmark on one line with non-breaking spaces.",
      "Do use Manrope for headings and the brand, system sans for prose, and monospace for commands and flags.",
      "Do preserve the clear web-first, SSH-second hierarchy and the explicit VPN requirement.",
      "Do keep focus visible and allow long flags and commands to wrap.",
      "Do respect reduced motion and maintain the single-column mobile reading order."
    ],
    "donts": [
      "Don't use shadows to replace the existing tonal and border hierarchy.",
      "Don't make the secondary SSH terminal compete with the web-flag action.",
      "Don't turn source snippets into decorative monospace body copy.",
      "Don't add color roles, font families or component variants absent from the implementation."
    ]
  }
}
