{
  "schema": "cib-exercise/1",
  "exercise": {
    "name": "Журнал зв’язку: веб і SSH",
    "description": "Відновіть повідомлення з архіву та знайдіть другий прапор через SSH. Веб доступний через проксі або VPN.",
    "tags": [
      "тестове",
      "демонстрація"
    ]
  },
  "versions": [
    {
      "status": "published",
      "admin_note": "Демонстраційний набір v1.0.0",
      "variants": [
        {
          "index": 1,
          "tasks": [
            {
              "name": "Передача Р-17",
              "difficulty": "elementary",
              "description": "Запустіть середовище та відкрийте вебсторінку через проксі: {{web_proxy}}. VPN для цього способу не потрібен.\n\nЩоб перевірити VPN, підключіться за інструкцією у вікні VPN та відкрийте ту саму сторінку: {{web_vpn}}.\n\nУ журналі є переданий пакет. Перегляньте нотатку, знайдіть вкладення та відновіть початковий текст повідомлення. Отриманий прапор надішліть як відповідь.",
              "flag": [
                "template:ICE{web_[a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9]}"
              ],
              "linked_device": "welcome",
              "device_flag_var": "WEB_FLAG",
              "placeholders": [
                {
                  "key": "web_proxy",
                  "kind": "external.link",
                  "device_name": "welcome"
                },
                {
                  "key": "web_vpn",
                  "kind": "ip",
                  "ip_reference": "vpn",
                  "last_octet": 10,
                  "as_link": true,
                  "scheme": "http",
                  "port": 8080
                }
              ]
            },
            {
              "name": "Підключення через SSH",
              "difficulty": "elementary",
              "description": "Підключіться до VPN. У терміналі виконайте команду: ssh -p 2222 demo@{{server_ip}}\n\nПароль демонстраційного користувача: cybericebox. Прапор збережено у файлі flag.txt у його домашній папці.\n\nНадішліть другий прапор як відповідь. Для перевірки виходу в інтернет можна виконати: curl -I https://example.com.",
              "flag": [
                "template:ICE{ssh_[a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9][a-f0-9]}"
              ],
              "linked_device": "welcome",
              "device_flag_var": "SSH_FLAG",
              "placeholders": [
                {
                  "key": "server_ip",
                  "kind": "ip",
                  "ip_reference": "vpn",
                  "last_octet": 10
                }
              ]
            }
          ],
          "topology": {
            "vpn": {
              "enabled": true,
              "dhcp": false
            },
            "internet": {
              "enabled": true,
              "dhcp": false,
              "dns": "1.1.1.1"
            },
            "devices": [
              {
                "name": "welcome",
                "type": "container",
                "image": "cybericebox/test-exercises:v1.0.0",
                "resource_preset": "micro",
                "security_preset": "standard",
                "interfaces": [
                  {
                    "name": "eth0",
                    "ip": {
                      "type": "static",
                      "address_ref": {
