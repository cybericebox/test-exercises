                        "host": 10
                      },
                      "routes": [
                        {
                          "dst": "10.128.0.0/10",
                          "via_ref": {
                            "network": "vpn",
                            "host": 1
                          }
                        }
                      ]
                    }
                  },
                  {
                    "name": "eth1",
                    "ip": {
                      "type": "static",
                      "address_ref": {
                        "network": "internet",
                        "host": 10
                      },
                      "gateway_ref": {
                        "network": "internet",
                        "host": 1
                      }
                    }
                  }
                ],
                "external": {
                  "port": 8080,
                  "protocol": "http"
                }
              }
            ],
            "connections": [
              {
                "endpoints": [
                  {
                    "kind": "vpn",
